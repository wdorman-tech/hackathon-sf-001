# Dynamic environment ID — Dashboard → Developer → API
# https://app.dynamic.xyz/dashboard/developer/api
DYNAMIC_ENVIRONMENT_ID=

# --- Route 1: developer-managed server wallets --------------------------------
# Server-level API token used to create/own wallets on your backend's behalf.
# Dashboard → Developer → API → create a new API token.
DYNAMIC_API_TOKEN=

# --- Route 2: agent logs in as its own Dynamic user ----------------------------
# A 32-byte secp256k1 private key that IS the agent's identity (not a wallet key).
# Generate one per agent, once, and store it in a secrets vault:
#   node -e "const {generatePrivateKey}=require('viem/accounts'); console.log(generatePrivateKey())"
# Rotating this value creates a brand-new Dynamic user with no access to the old wallet.
AGENT_SIGNING_TOKEN=

# Origin the agent presents as during sign-in. Must be an allow-listed CORS origin
# in Dynamic Dashboard → Developer → CORS.
APP_ORIGIN=https://example.com

# --- Shared -------------------------------------------------------------------
# Password protecting MPC key shares backed up to Dynamic (backUpToDynamic: true).
# Use a strong, unique value; in production, generate and store it in a secrets manager.
WALLET_PASSWORD=

# Chain + RPC used for signing and paying. Defaults to Base Sepolia (testnet) so you
# aren't spending real funds while exploring the app. Switch CHAIN_ID=8453 and
# RPC_URL=https://mainnet.base.org for Base mainnet, where the Fireblocks x402
# facilitator settles zero-fee USDC payments — the public demo x402 endpoint below
# may only accept mainnet payments; check its response if a testnet payment is rejected.
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org

# USDC contract address for the balance check in the web UI. Auto-resolved for
# Base (8453) and Base Sepolia (84532); set this explicitly for any other chain.
USDC_ADDRESS=

# x402-gated resource each agent pays for. Defaults to Dynamic's public demo API.
X402_RESOURCE_URL=https://x402-api.fly.dev/api/price-feed
