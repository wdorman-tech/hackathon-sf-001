# ── Runware ─ all AI inference (one endpoint, every model) ───────────────────
# Get a key at https://runware.ai/wallet  (hackathon credit code: YCSSHACKATHON)
# We POST the native task API: [{"taskType": "textInference", ...}] over httpx.
# (Runware also exposes an OpenAI-compatible /v1/chat/completions shim, but it's
#  text-only — no image inputs, no jsonSchema — so we don't use it.)
# Leave RUNWARE_API_KEY blank to run the deterministic rules-based classifier and
# the heuristic valuation fallback — the whole app still works end-to-end offline.
RUNWARE_API_KEY=
RUNWARE_BASE_URL=https://api.runware.ai/v1
# AIR model ids: `creator:family@version`. Browse at https://runware.ai/models.
# sonnet-4.6 does text AND image-to-text, so one id covers research/classify/draft/vision.
RUNWARE_MODEL=anthropic:claude@sonnet-4.6

# ── Linq ─ iMessage / RCS / SMS (Partner API v3) ─────────────────────────────
LINQ_API_KEY=
LINQ_BASE_URL=https://api.linqapp.com
LINQ_FROM_NUMBER=+12052611117
# Set this and inbound webhook signatures are enforced automatically (no flag needed).
LINQ_WEBHOOK_SECRET=

# ── Research ─ Closer's own agentic product research (sets V and R) ──────────
# No human expert in the loop: a bounded ReAct agent reads the listing, searches
# for comps, reads what it finds, and returns a cited valuation.
RESEARCH_MODE=live         # live | mock  (mock = instant canned payload for the demo)
RESEARCH_MAX_STEPS=6       # tool-call budget per run
RESEARCH_TIMEOUT_S=20      # per-HTTP-call timeout inside the loop
RESEARCH_PAGE_CHARS=8000   # per-page text cap fed back to the model
SEARCH_PROVIDER=ddg        # ddg (keyless, default) | brave | serper
SEARCH_RESULTS=5
RESEARCH_MAX_REDIRECTS=4
RESEARCH_ALLOW_PRIVATE_HOSTS=false   # dev only: lets fetch_page hit localhost/private IPs
BRAVE_API_KEY=             # only if SEARCH_PROVIDER=brave
SERPER_API_KEY=            # only if SEARCH_PROVIDER=serper

# ── Clerk ─ user auth for the dashboard (app/auth.py verifies the session JWT) ──
# Provision via Vercel Marketplace: `vercel integration add clerk` — it writes the
# Clerk env vars into the project for you. Blank (or DEV_AUTH=true) => dev user.
# CLERK_ISSUER is REQUIRED to enable Clerk — without it there is no `iss` to verify.
# On a production deploy (VERCEL_ENV=production) an unconfigured Clerk is a 503, not an
# open door; DEV_AUTH=true is the explicit opt-in to run open.
CLERK_ISSUER=                        # https://<your-app>.clerk.accounts.dev
CLERK_JWKS_URL=                      # optional; defaults to {issuer}/.well-known/jwks.json
CLERK_AUTHORIZED_PARTIES=            # optional CSV of allowed `azp` (your domains)
DEV_AUTH=false                       # true => bypass Clerk, use DEV_USER_ID
DEV_USER_ID=demo_user

# ── Storage ─ REQUIRED on Vercel (serverless has no shared process memory) ───
# Provision via Vercel Marketplace: `vercel integration add upstash`.
# Both blank => in-process MemoryStore (fine locally, wrong on Vercel).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Behavior ─────────────────────────────────────────────────────────────────
VERIFY_LINQ_SIGNATURES=false
DEMO_MODE=false
PORT=8000
