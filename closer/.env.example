# ── Runware ─ all AI inference (one endpoint, every model) ───────────────────
# Get a key at https://runware.ai/wallet  (hackathon credit code: YCSSHACKATHON)
# We POST the native task API: [{"taskType": "textInference", ...}] over httpx.
# (Runware also exposes an OpenAI-compatible /v1/chat/completions shim, but it's
#  text-only — no image inputs, no jsonSchema — so we don't use it.)
# Leave RUNWARE_API_KEY blank to run the deterministic rules-based classifier
# fallback (no network, no key) — the whole app still works end-to-end offline.
RUNWARE_API_KEY=
RUNWARE_BASE_URL=https://api.runware.ai/v1
# AIR model ids: `creator:family@version`. Browse at https://runware.ai/models.
# sonnet-4.6 does text AND image-to-text, so one id covers classify/draft/vision.
RUNWARE_MODEL=anthropic:claude@sonnet-4.6

# ── Linq ─ iMessage / RCS / SMS (Partner API v3) ─────────────────────────────
LINQ_API_KEY=
LINQ_BASE_URL=https://api.linqapp.com
LINQ_FROM_NUMBER=+12052611117

# ── Terac ─ verified expert valuations (sets the walk-away price R) ───────────
TERAC_MODE=mock            # mock | live
TERAC_API_KEY=
TERAC_BASE_URL=

# ── Behavior ─────────────────────────────────────────────────────────────────
VERIFY_LINQ_SIGNATURES=false
DEMO_MODE=false
PORT=8000
